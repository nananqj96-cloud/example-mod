{
	"geode": "5.8.2",
	"gd": { "win": "2.2081", "android": "2.2081" },
	"id": "nananqj96.fake-heart-rate",
	"name": "Fake Heart Rate",
	"version": "v1.0.0",
	"developer": "nananqj96",
	"description": "A configurable fake heart-rate monitor for Geometry Dash.",
	"settings": {
		"enabled": { "type": "bool", "name": "Enable fake heart rate", "default": true },
		"show-percentage": { "type": "bool", "name": "Show percentage", "default": true },
		"first-threshold": { "type": "int", "name": "First threshold (%)", "default": 40, "min": 1, "max": 98 },
		"second-threshold": { "type": "int", "name": "Second threshold (%)", "default": 60, "min": 2, "max": 99 },
		"zone-1-min": { "type": "int", "name": "Zone 1 minimum BPM", "default": 90, "min": 30, "max": 300 },
		"zone-1-max": { "type": "int", "name": "Zone 1 maximum BPM", "default": 110, "min": 30, "max": 300 },
		"zone-2-min": { "type": "int", "name": "Zone 2 minimum BPM", "default": 120, "min": 30, "max": 300 },
		"zone-2-max": { "type": "int", "name": "Zone 2 maximum BPM", "default": 140, "min": 30, "max": 300 },
		"zone-3-min": { "type": "int", "name": "Zone 3 minimum BPM", "default": 140, "min": 30, "max": 300 },
		"zone-3-max": { "type": "int", "name": "Zone 3 maximum BPM", "default": 220, "min": 30, "max": 300 },
		"change-speed": { "type": "int", "name": "Change speed", "description": "BPM change per update; lower is smoother.", "default": 3, "min": 1, "max": 20 },
		"update-interval": { "type": "int", "name": "Update interval (frames)", "default": 6, "min": 1, "max": 60 }
	}
}
